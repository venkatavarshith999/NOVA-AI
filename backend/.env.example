# Copy this file to .env and fill in your keys.
# The app runs in MOCK MODE automatically if these are missing —
# fully functional demo, no keys required for the hackathon judges.

GEMINI_API_KEY=
TAVILY_API_KEY=

# comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://localhost:3000
